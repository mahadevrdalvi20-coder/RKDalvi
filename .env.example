# Copy to .env (or set in your hosting dashboard). Only BASE_URL is essential.
NODE_ENV=production
PORT=3000
BASE_URL=https://rkdalvi.com
# Set to 1 when running behind a reverse proxy / load balancer (Render, Railway, nginx, Caddy)
TRUST_PROXY=1
# Where the database, photos and backups live. Must be a PERSISTENT disk.
DATA_DIR=/data
BACKUP_KEEP=14

# Email: new-enquiry alerts + password reset (e.g. Gmail app password, Zoho, Brevo, SES)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="R. K. DALVI <no-reply@rkdalvi.com>"
# Extra people to alert about enquiries (comma separated). Admins are alerted automatically.
NOTIFY_EMAILS=

# Mobile + OTP login (optional, via Twilio SMS). Without it, use email + password.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Push notifications work out of the box (keys are generated automatically).
# Set these only if you want fixed keys: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@rkdalvi.com

# Android app (Google Play) — see docs/ANDROID.md
ANDROID_PACKAGE=com.rkdalvi.app
ANDROID_SHA256_FINGERPRINTS=

# Optional Google Analytics 4
GA_MEASUREMENT_ID=

SESSION_IDLE_MINUTES=120
MAX_VIDEO_MB=50
