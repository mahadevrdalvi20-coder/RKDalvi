</main>
<footer class="site-footer">
  <div class="wrap footer-grid">
    <div>
      <div class="footer-brand"><%= s.name %></div>
      <p class="muted-light"><%= s.tagline %></p>
      <div class="social">
        <% if (s.instagram) { %><a href="<%= s.instagram %>" target="_blank" rel="noopener" aria-label="Instagram"><%- icon('instagram') %></a><% } %>
        <% if (s.facebook) { %><a href="<%= s.facebook %>" target="_blank" rel="noopener" aria-label="Facebook"><%- icon('facebook') %></a><% } %>
        <% if (s.google_business) { %><a href="<%= s.google_business %>" target="_blank" rel="noopener" aria-label="Google Business profile"><%- icon('google') %></a><% } %>
        <% if (s.youtube) { %><a href="<%= s.youtube %>" target="_blank" rel="noopener" aria-label="YouTube"><%- icon('youtube') %></a><% } %>
      </div>
    </div>
    <div>
      <h3>Explore</h3>
      <ul class="flinks">
        <li><a href="/work">Our Work</a></li>
        <li><a href="/services">Services</a></li>
        <li><a href="/about">About Us</a></li>
        <li><a href="/contact">Get a Quote</a></li>
      </ul>
    </div>
    <div>
      <h3>Contact</h3>
      <ul class="flinks">
        <li><a href="<%= telLink %>"><%- icon('phone') %> <%= s.phone %></a></li>
        <li><a href="<%= waLink() %>" target="_blank" rel="noopener"><%- icon('whatsapp') %> WhatsApp</a></li>
        <% if (s.email) { %><li><a href="mailto:<%= s.email %>"><%- icon('mail') %> <%= s.email %></a></li><% } %>
        <li><a href="<%= mapsLink %>" target="_blank" rel="noopener"><%- icon('pin') %> <%= s.address %></a></li>
      </ul>
    </div>
    <div>
      <h3>Working hours</h3>
      <p class="muted-light pre"><%= s.hours %></p>
    </div>
  </div>
  <div class="wrap footer-bottom">
    <span>© <%= new Date().getFullYear() %> <%= s.name %>. All rights reserved.</span>
    <a href="/privacy">Privacy Policy</a>
  </div>
</footer>

<nav class="action-bar" aria-label="Quick contact">
  <a href="<%= telLink %>" class="ab-call"><%- icon('phone') %><span>Call</span></a>
  <a href="<%= waLink() %>" class="ab-wa" target="_blank" rel="noopener"><%- icon('whatsapp') %><span>WhatsApp</span></a>
  <a href="/contact" class="ab-quote"><%- icon('file') %><span>Get a Quote</span></a>
</nav>
<script src="/assets/js/site.js" defer></script>
<% if (typeof extraScripts !== 'undefined') { %><%- extraScripts %><% } %>
</body>
</html>
