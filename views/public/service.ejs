<%- include('../partials/head') %>
<%- include('../partials/header') %>
<section class="page-hero">
  <div class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/services">Services</a><%- icon('right') %><span><%= svc.name %></span></nav>
    <h1><%= svc.name %></h1>
    <p class="lead"><%= svc.description %></p>
    <div class="hero-actions-inline">
      <a href="/contact?service=<%= svc.slug %>" class="btn btn-gold">Get a quote for <%= svc.name.toLowerCase() %></a>
      <a href="<%= waLink(`Hello ${s.name}, I am interested in ${svc.name}.`) %>" class="btn btn-wa" target="_blank" rel="noopener"><%- icon('whatsapp') %> WhatsApp</a>
    </div>
  </div>
</section>
<section class="section section-top0">
  <div class="wrap">
    <% if (svc.image) { %><img class="svc-banner" src="<%= media(svc.image) %>" alt="<%= svc.name %>"><% } %>
    <h2>Related projects</h2>
    <% if (projects.length) { %>
      <div class="pgrid"><% projects.forEach(p => { %><%- include('../partials/project-card', { p }) %><% }) %></div>
    <% } else { %>
      <p class="muted">Photos of our <%= svc.name.toLowerCase() %> work will be added here soon. <a href="/work">Browse all projects</a>.</p>
    <% } %>
    <h2 class="mt-xl">Other services</h2>
    <div class="cat-chips"><% others.forEach(o => { %><a class="chip" href="/services/<%= o.slug %>"><%= o.name %></a><% }) %></div>
  </div>
</section>
<%- include('../partials/cta') %>
<%- include('../partials/footer') %>
